# ---------------------------------------------------------------------------
# B2B Wheels Collect — variables d'environnement
# Copiez ce fichier en .env.local (local) ou saisissez ces valeurs dans
# l'interface de votre hébergeur. Ne versionnez jamais de vraies valeurs.
# ---------------------------------------------------------------------------

# Adresse publique du site (liens dans les emails).
APP_URL=http://localhost:3000

# true = tout est simulé (agenda local + emails non envoyés). Mettre à false en production.
DEMO_MODE=true

# Secret serveur, 32 caractères minimum, obligatoire dès qu'un service réel est actif.
# Générer : openssl rand -base64 48
APP_SECRET=

# --- Google Agenda ---------------------------------------------------------
# Identifiant de l'agenda « B2B Wheels Collect — Enlèvements » (Paramètres de l'agenda > Intégrer l'agenda).
GOOGLE_CALENDAR_ID=

# Option A — compte de service (recommandé). L'agenda doit être partagé avec cette adresse
# avec le droit « Apporter des modifications aux événements ».
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clé privée du fichier JSON (champ private_key), sur une ligne avec des \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Option B — OAuth (si la création de clé de compte de service est interdite).
# Renseigner les deux premières valeurs puis lancer : npm run google:connect
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Emails (Resend) -------------------------------------------------------
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié chez Resend.
EMAIL_FROM="B2B Wheels Collect <enlevements@votre-domaine.be>"
# Adresse(s) VBM qui reçoivent chaque nouvel enlèvement (séparées par des virgules).
VBM_NOTIFICATION_EMAIL=
# Adresse qui reçoit les réponses des garages (par défaut : la première adresse VBM).
EMAIL_REPLY_TO=

# --- Renvoi automatique des emails en échec --------------------------------
# Vercel Cron l'envoie automatiquement dans l'en-tête Authorization.
CRON_SECRET=

# --- Optionnel : verrou partagé (recommandé sur Vercel) --------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optionnel : anti-spam Cloudflare Turnstile ----------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Coordonnées affichées sur le site et dans les emails ------------------
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Mentions de la politique de confidentialité (à compléter par VBM) -----
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_VAT_NUMBER=
LEGAL_PRIVACY_EMAIL=
# Exemple : "pendant 24 mois après l'enlèvement"
LEGAL_RETENTION=
